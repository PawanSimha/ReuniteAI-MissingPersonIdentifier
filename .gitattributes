# Normalize line endings in the repository
* text=auto

# Source & text files: normalize to LF on checkout
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
Procfile text eol=lf
.editorconfig text eol=lf
.github/** text eol=lf

# Windows batch files stay CRLF
*.bat text eol=crlf

# Binary files (never convert)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.dat binary
*.pkl binary
*.db binary
*.sqlite3 binary
*.dump binary
*.model binary