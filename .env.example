# ReuniteAI environment configuration
# Copy to .env and fill in real values. NEVER commit .env to the repository.

# Flask session signing key — set a strong random value in production
SECRET_KEY=your_secret_key_here

# MongoDB connection string.
# Local runs: mongodb://localhost:27017/
# Docker Compose overrides this automatically to mongodb://db:27017/ (db service)
MONGO_URI=mongodb://localhost:27017/

# MongoDB database name
DB_NAME=reuniteai_db

# Auto-created admin account on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# HTTP port for the dev server (default 5000; 8000 inside the container)
PORT=5000

# Enable Flask debug mode (True/1 to enable)
FLASK_DEBUG=False